<?xml version="1.0"?>
<!-- Total mass 1285 kg distributed approx (base 350, column 350, upper arm 330, forearm 190, wrist 45, tool 20).
     Efforts are static worst-case estimates with 150 kg payload, not KUKA data.
     4-axis articulated arm, proportions approximating KUKA KR 210 L150. Units: meters, radians.
     L1=0.675 L2=0.350 L3=1.350 L4=1.400 LF=0.150  (horizontal reach L2+L3+L4 = 3.1 m)
     wrist_comp must be driven by the middleware = -(q2 + q3). -->
<robot name="arm4_kr210_like">

  <material name="orange"><color rgba="0.95 0.45 0.05 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="grey"><color rgba="0.55 0.55 0.55 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.40" length="0.10"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.40" length="0.10"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.30"/>
      <geometry><cylinder radius="0.28" length="0.50"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.30"/>
      <geometry><cylinder radius="0.28" length="0.50"/></geometry>
    </collision>
    <inertial><origin xyz="0 0 0.3"/><mass value="350"/>
      <inertia ixx="14.15" iyy="14.15" izz="13.72" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.22886" upper="3.22886" effort="10000" velocity="2.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.45"/>
      <geometry><cylinder radius="0.25" length="0.35"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.45"/>
      <geometry><cylinder radius="0.25" length="0.35"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.175 0 0.675"/>
      <geometry><box size="0.45 0.40 0.30"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0.675"/>
      <geometry><box size="0.45 0.40 0.30"/></geometry>
    </collision>
    <inertial><origin xyz="0.15 0 0.6"/><mass value="350"/>
      <inertia ixx="29.53" iyy="30.92" izz="13.20" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="upper_arm"/>
    <origin xyz="0.350 0 0.675"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.28122" upper="0.61087" effort="25000" velocity="2.0"/>
  </joint>

  <link name="upper_arm">
    <visual>
      <origin xyz="0.675 0 0"/>
      <geometry><box size="1.35 0.30 0.28"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.675 0 0"/>
      <geometry><box size="1.35 0.30 0.28"/></geometry>
    </collision>
    <inertial><origin xyz="0.675 0 0"/><mass value="330"/>
      <inertia ixx="4.63" iyy="52.27" izz="52.59" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="1.350 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.5" effort="9000" velocity="2.0"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0.7 0 0"/>
      <geometry><box size="1.40 0.22 0.20"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.7 0 0"/>
      <geometry><box size="1.40 0.22 0.20"/></geometry>
    </collision>
    <inertial><origin xyz="0.7 0 0"/><mass value="190"/>
      <inertia ixx="1.40" iyy="31.67" izz="31.80" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- Compensation joint: target = -(q2 + q3) keeps tool vertical -->
  <joint name="wrist_comp" type="revolute">
    <parent link="forearm"/><child link="wrist"/>
    <origin xyz="1.400 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.3" upper="6.3" effort="1500" velocity="4.0"/>
  </joint>

  <link name="wrist">
    <visual>
      <geometry><sphere radius="0.11"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.11"/></geometry>
    </collision>
    <inertial><mass value="45"/>
      <inertia ixx="0.22" iyy="0.22" izz="0.22" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="wrist"/><child link="tool"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.10865" upper="6.10865" effort="800" velocity="6.0"/>
  </joint>

  <link name="tool">
    <visual>
      <origin xyz="0 0 -0.075"/>
      <geometry><cylinder radius="0.07" length="0.15"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.075"/>
      <geometry><cylinder radius="0.07" length="0.15"/></geometry>
    </collision>
    <inertial><origin xyz="0 0 -0.075"/><mass value="20"/>
      <inertia ixx="0.06" iyy="0.06" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="tcp_fixed" type="fixed">
    <parent link="tool"/><child link="tcp"/>
    <origin xyz="0 0 -0.150"/>
  </joint>
  <link name="tcp"/>

</robot>

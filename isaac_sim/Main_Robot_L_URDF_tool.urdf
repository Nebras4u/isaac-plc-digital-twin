<?xml version="1.0"?>
<!-- 4-axis approximation of KUKA KR 210 L150
     Links merged: original L3+L4 → link_3, L5+L6 → link_4/tool
     Masses scaled to realistic total ≈ 1410 kg
     Kinematics: L1=0.675  L2=0.350  L3=1.350  L4=1.400  LF=0.089084 (Updated)

     v0.3.0 — tool is now the TCP directly.
     joint_4 origin = (0, 0, -0.089084) matches PLC LF.
     tcp_fixed and tcp link removed.

     Joint rename map:
       joint1 -> joint_1
       joint2 -> joint_2
       joint3 -> joint_3
       A5     -> joint_5
       joint4 -> joint_4
     Link rename map:
       link1     -> link_1
       upper_arm -> link_2
       forearm   -> link_3
       wrist     -> link_4

     Drive parameters (Isaac Sim):
       joint_1: Max Force = 50000
       all joints: Damping = 100000, Stiffness = 1000000
-->
<robot name="Main_Robot_L_URDF">

  <material name="kuka_orange"><color rgba="0.95 0.40 0.05 1"/></material>
  <material name="kuka_dark"><color rgba="0.18 0.18 0.18 1"/></material>
  <material name="kuka_grey"><color rgba="0.45 0.45 0.45 1"/></material>
  <material name="kuka_light"><color rgba="0.65 0.65 0.65 1"/></material>

  <!-- ========== BASE ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.42" length="0.08"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.42" length="0.08"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.28"/>
      <geometry><cylinder radius="0.30" length="0.40"/></geometry>
      <material name="kuka_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.28"/>
      <geometry><cylinder radius="0.30" length="0.40"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.50"/>
      <geometry><cylinder radius="0.32" length="0.06"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <inertial>
      <origin xyz="-0.02 0 0.20"/>
      <mass value="380"/>
      <inertia ixx="18" iyy="18" izz="15" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========== JOINT_1 (A1) ========== -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.53"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.22886" upper="3.22886" effort="50000" velocity="2.0"/>
    <dynamics damping="100000" stiffness="1000000"/>
  </joint>

  <!-- ========== LINK_1 ========== -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.18"/>
      <geometry><cylinder radius="0.24" length="0.36"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.18"/>
      <geometry><cylinder radius="0.24" length="0.36"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.18 0 0.145"/>
      <geometry><box size="0.42 0.38 0.32"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="0.18 0 0.145"/>
      <geometry><box size="0.42 0.38 0.32"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.05 0.22 0.14"/>
      <geometry><box size="0.22 0.08 0.28"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <visual>
      <origin xyz="0.05 -0.22 0.14"/>
      <geometry><box size="0.22 0.08 0.28"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <inertial>
      <origin xyz="-0.03 -0.02 0.20"/>
      <mass value="340"/>
      <inertia ixx="28" iyy="30" izz="14" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========== JOINT_2 (A2) ========== -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0.350 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.28122" upper="0.61087" effort="25000" velocity="2.0"/>
    <dynamics damping="100000" stiffness="1000000"/>
  </joint>

  <!-- ========== LINK_2 (formerly upper_arm) ========== -->
  <link name="link_2">
    <visual>
      <origin xyz="0.675 0 0"/>
      <geometry><box size="1.30 0.26 0.24"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="0.675 0 0"/>
      <geometry><box size="1.30 0.26 0.24"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.08 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.16" length="0.34"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <visual>
      <origin xyz="1.27 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.14" length="0.30"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <visual>
      <origin xyz="0.50 0.15 0"/>
      <geometry><box size="0.70 0.04 0.18"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <visual>
      <origin xyz="0.50 -0.15 0"/>
      <geometry><box size="0.70 0.04 0.18"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <inertial>
      <origin xyz="0.02 -0.12 0.30"/>
      <mass value="280"/>
      <inertia ixx="5" iyy="48" izz="48" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========== JOINT_3 (A3) ========== -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="1.350 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.5" effort="9000" velocity="2.0"/>
    <dynamics damping="100000" stiffness="1000000"/>
  </joint>

  <!-- ========== LINK_3 (formerly forearm) ========== -->
  <link name="link_3">
    <visual>
      <origin xyz="0.70 0 0"/>
      <geometry><box size="1.35 0.20 0.18"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="0.70 0 0"/>
      <geometry><box size="1.35 0.20 0.18"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.06 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.13" length="0.28"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <visual>
      <origin xyz="1.34 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.12" length="0.26"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <visual>
      <origin xyz="0.70 0 0.11"/>
      <geometry><box size="1.20 0.08 0.04"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <inertial>
      <origin xyz="0.40 0.10 -0.03"/>
      <mass value="260"/>
      <inertia ixx="3" iyy="45" izz="45" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========== JOINT_5 (A5) ========== -->
  <joint name="joint_5" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="1.400 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.3" upper="6.3" effort="1500" velocity="4.0"/>
    <dynamics damping="100000" stiffness="1000000"/>
  </joint>

  <!-- ========== LINK_4 (formerly wrist) ========== -->
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.12" length="0.20"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.12" length="0.20"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.08"/></geometry>
      <material name="kuka_grey"/>
    </visual>
    <inertial>
      <origin xyz="0.05 0.02 0"/>
      <mass value="80"/>
      <inertia ixx="0.4" iyy="0.4" izz="0.3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========== JOINT_4 (A4) ========== -->
  <!-- Tool is now the TCP directly: offset = LF = 89.084 mm -->
  <joint name="joint_4" type="revolute">
    <parent link="link_4"/><child link="tool"/>
    <origin xyz="0 0 -0.089084"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.10865" upper="6.10865" effort="800" velocity="6.0"/>
    <dynamics damping="100000" stiffness="1000000"/>
  </joint>

  <!-- ========== TOOL (is the TCP) ========== -->
  <link name="tool">
    <visual>
      <origin xyz="0 0 -0.044542"/>
      <geometry><cylinder radius="0.075" length="0.089084"/></geometry>
      <material name="kuka_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.044542"/>
      <geometry><cylinder radius="0.075" length="0.089084"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 -0.089084"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="kuka_dark"/>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.044542"/>
      <mass value="20"/>
      <inertia ixx="0.08" iyy="0.08" izz="0.05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
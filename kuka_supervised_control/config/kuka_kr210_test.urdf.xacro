<?xml version="1.0"?>
<robot name="kuka_kr210" xmlns:xacro="http://ros.org">
  <link name="base_link"/>
  <link name="link_1"/><link name="link_2"/><link name="link_3"/>
  <link name="link_4"/><link name="link_5"/><link name="link_6"/>

  <joint name="joint_a1" type="revolute"><parent link="base_link"/><child link="link_1"/><axis xyz="0 0 1"/><limit lower="-3.22" upper="3.22" effort="1000" velocity="2.0"/></joint>
  <joint name="joint_a2" type="revolute"><parent link="link_1"/><child link="link_2"/><axis xyz="0 1 0"/><limit lower="-2.44" upper="-0.08" effort="1000" velocity="2.0"/></joint>
  <joint name="joint_a3" type="revolute"><parent link="link_2"/><child link="link_3"/><axis xyz="0 1 0"/><limit lower="-2.09" upper="2.93" effort="1000" velocity="2.1"/></joint>
  <joint name="joint_a4" type="revolute"><parent link="link_3"/><child link="link_4"/><axis xyz="1 0 0"/><limit lower="-6.10" upper="6.10" effort="1000" velocity="3.1"/></joint>
  <joint name="joint_a5" type="revolute"><parent link="link_4"/><child link="link_5"/><axis xyz="0 1 0"/><limit lower="-2.18" upper="2.18" effort="1000" velocity="3.0"/></joint>
  <joint name="joint_a6" type="revolute"><parent link="link_5"/><child link="link_6"/><axis xyz="1 0 0"/><limit lower="-6.10" upper="6.10" effort="1000" velocity="3.8"/></joint>

  <xacro:include filename="$(find kuka_supervised_control)/config/kuka_kr210_hw.xacro"/>
</robot>
